---
/**
 * SiteFooter — three groups of links, the subscribe block, and the copyright
 * line. The groups come from SITE.footer: the four pages, the four subpages,
 * and the housekeeping links. A hairline above separates it from the page; the
 * bottom padding clears the room frame.
 */
import Subscribe from './Subscribe.astro';
import { SITE, isCurrentPath } from '../lib/site';

const here = Astro.url.pathname;
const isCurrent = (href: string) => !href.startsWith('mailto:') && isCurrentPath(here, href);

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="shell site-footer__inner">
		<nav class="site-footer__nav" aria-label="Footer">
			{
				SITE.footer.map((group) => (
					<ul>
						{group.map((item) => (
							<li>
								<a
									class="footer-link"
									href={item.href}
									aria-current={isCurrent(item.href) ? 'page' : undefined}
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				))
			}
		</nav>

		<Subscribe id="footer" compact />

		<p class="site-footer__copy">© {year} {SITE.name}</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--rule);
		padding-block: var(--sp-section) calc(var(--gutter) + var(--sp-4));
	}

	.site-footer__inner {
		display: flex;
		flex-direction: column;
		gap: var(--sp-5);
	}

	.site-footer__nav {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-5) var(--sp-7);
	}

	.site-footer__nav ul {
		display: flex;
		flex-direction: column;
		gap: var(--sp-2);
		list-style: none;
		padding: 0;
	}

	/* Footer links speak in the same small tracked voice as the header nav,
	   with the same ember wipe on hover. */
	.footer-link {
		display: inline-block;
		position: relative;
		padding-block: 0.3em;
		font-family: var(--font-ui);
		font-size: var(--fs-label);
		font-weight: 500;
		letter-spacing: var(--track-label);
		line-height: var(--lh-ui);
		text-transform: uppercase;
		color: var(--ink-soft);
		text-decoration: none;
	}

	.footer-link::after {
		content: '';
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		height: 1px;
		background: var(--ember);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--t-base) var(--ease-out);
	}

	.footer-link:hover {
		color: var(--ink);
	}

	.footer-link:hover::after {
		transform: scaleX(1);
	}

	/* The page you are on keeps its rule showing, in the accent, as the header
	   nav does. A reader who arrived by scrolling to the foot is on this page
	   and should be able to see that. */
	.footer-link[aria-current='page'] {
		color: var(--ember);
	}

	.footer-link[aria-current='page']::after {
		transform: scaleX(1);
	}

	.site-footer__copy {
		font-family: var(--font-ui);
		font-size: var(--fs-small);
		color: var(--ink-muted);
	}
</style>
