---
/**
 * ServiceCard — the two ways to work together.
 *
 * Used on the home teaser and again on the services index, so the layout is
 * driven by content (the `order`, `engagement` and `price` frontmatter) rather
 * than by which page it happens to be on. Fields are optional in the schema
 * and simply absent here when they are not set.
 */
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';

type Service = CollectionEntry<'services'>;

interface Props {
	items: Service[];
	/** On the home page the card is a teaser; on /services it is the whole entry. */
	compact?: boolean;
	/**
	 * One offer per row at full width, rather than the teaser's side-by-side
	 * pair. The index has the page to itself and nothing to compete with, so
	 * each offer gets the measure and the whole of its detail list.
	 */
	stacked?: boolean;
}

const { items, compact = false, stacked = false } = Astro.props;
---

<ul class:list={['services', stacked && 'services--stacked']} role="list">
	{
		items.map((service) => (
			<li class="service">
				<div class="service__main">
					<h3 class="service__title">{service.data.title}</h3>

					<p class="service__summary">{service.data.summary}</p>

					{(service.data.engagement || service.data.price) && (
						<p class="service__terms">
							{/* One inline run, not a row of boxes: as flex items the
							    separator could end a line on its own. */}
							{[service.data.engagement, service.data.price]
								.filter(Boolean)
								.join(' · ')}
						</p>
					)}
				</div>

				{!compact && service.data.forWhom.length > 0 && (
					<div class="service__for">
						<p class="label">Who it is for</p>
						<ul class="service__list">
							{service.data.forWhom.map((line) => (
								<li>{line}</li>
							))}
						</ul>
					</div>
				)}

				<Button quiet href={`/services/${service.id}`}>
					Read more
				</Button>
			</li>
		))
	}
</ul>

<style>
	.services {
		display: grid;
		/* min(), not the bare 20rem: a minmax floor is a hard minimum, so a
		   20rem track inside a 19rem column overflows rather than yielding. On a
		   360px phone the column really is narrower than 20rem once the gutter is
		   taken off both sides, and the cards ran out under the frame. Capping the
		   floor at the container's own width lets the track shrink instead. */
		grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
		gap: var(--sp-6) clamp(2rem, 4vw, 3.5rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* The teaser pairs offers side by side. The stacked variant gives each one
	   the full page: the summary and its terms on the left, the detail list on
	   the right. Same markup, same hairlines — only the room each entry gets
	   changes, which is why the difference is a modifier and not a component. */
	.services--stacked {
		grid-template-columns: minmax(0, 1fr);
		gap: var(--sp-7);
	}

	@media (min-width: 900px) {
		.services--stacked .service {
			display: grid;
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
			column-gap: clamp(2rem, 5vw, 5rem);
			align-items: start;
		}

		/* The summary may run to the measure when it has the room; in the
		   teaser's two-up grid that would leave a very ragged edge. */
		.services--stacked .service__main {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: var(--sp-3);
		}

		.services--stacked .service__summary {
			max-width: var(--measure);
		}

		.services--stacked .service__for {
			padding-block-start: 0.35rem;
		}
	}

	/* Hairline above, not a card. Structure comes from rules and space; there
	   is no border-box on this site. */
	.service {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--sp-3);
		padding-top: var(--sp-5);
		border-top: 1px solid var(--rule);
	}

	.service__title {
		font-family: var(--font-display);
		font-variation-settings: 'opsz' 30;
		font-weight: 600;
		font-size: var(--fs-display-s);
		line-height: 1.15;
	}

	.service__summary {
		font-size: var(--fs-body);
		line-height: 1.6;
		color: var(--ink-soft);
		max-width: 36ch;
	}

	/* Engagement and price, in the small tracked voice. No accent here. */
	.service__terms {
		font-family: var(--font-ui);
		font-size: var(--fs-label);
		font-weight: 500;
		letter-spacing: var(--track-label);
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.service__list {
		margin: var(--sp-2) 0 0;
		padding: 0;
		list-style: none;
		color: var(--ink-soft);
		font-size: var(--fs-body);
	}

	.service__list li {
		display: flex;
		gap: 0.75em;
		line-height: 1.5;
	}

	.service__list li + li {
		margin-top: 0.35em;
	}

	/* A short ember rule as the marker, rather than a round bullet. */
	.service__list li::before {
		content: '';
		flex: none;
		width: 0.75rem;
		margin-top: 0.7em;
		border-top: 1px solid var(--ember);
	}

	/* `margin-top: auto` pushes the button to the foot of the card, so a row of
	   services lines its buttons up however long the summaries run. */
	.service :global(.btn) {
		margin-top: auto;
		padding-top: var(--sp-3);
	}

	/* A grid item stretches to fill its column by default, which would drag the
	   button out to the full measure. A button is a fixed object: it is the
	   width of its own label. */
	.services--stacked .service :global(.btn) {
		justify-self: start;
	}
</style>
