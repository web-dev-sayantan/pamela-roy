---
/**
 * Catalogue — Move 7, the Card Catalogue.
 *
 * The complete index, month-grouped, rendered the way a library's card
 * catalogue is: a year rule, then the month printed once in the date margin
 * with its pieces listed under it. It is the "find it in under 3 clicks"
 * mechanism from §1 of the spec, and the most on-brand element on the site.
 *
 * Every row is one tab stop. The date is split into a compact visible form
 * and a full visually-hidden one, so a row whose month is inherited from the
 * row above it still announces a complete date.
 */
import type { Writing } from '../lib/writings';
import { groupByYear, shortDate, writingHref } from '../lib/writings';

interface Props {
	entries: Writing[];
	/** Adds the data attributes TopicFilter looks for. Off when unfiltered. */
	filterable?: boolean;
}

const { entries, filterable = false } = Astro.props;

const MONTH_ABBR = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];

const pad = (day: number) => String(day).padStart(2, '0');
const year = (entry: Writing) => String(entry.data.publishDate.getUTCFullYear());
const topic = (entry: Writing) => entry.data.topic;
---

<div class="catalogue">
	{
		groupByYear(entries).map((group) => (
			<section class="catalogue__year" data-year-group>
				<h3 class="label catalogue__heading">{group.year}</h3>

				{group.months.map((month) => (
					<ul class="catalogue__list" data-group>
						{month.items.map((entry, index) => (
							<li
								class="catalogue__row"
								data-topic={filterable ? topic(entry) : undefined}
								data-year={filterable ? year(entry) : undefined}
							>
								<span class="catalogue__date">
									{/* The first row of a month names the month; the rest
									    continue under it, the way a catalogue drawer
									    does. */}
									<span aria-hidden="true">
										{index === 0
											? `${MONTH_ABBR[entry.data.publishDate.getUTCMonth()]} ${pad(entry.data.publishDate.getUTCDate())}`
											: pad(entry.data.publishDate.getUTCDate())}
									</span>
									<span class="visually-hidden">{shortDate(entry.data.publishDate)}</span>
								</span>

								<a class="catalogue__title" href={writingHref(entry)}>
									{entry.data.title}
								</a>
							</li>
						))}
					</ul>
				))}
			</section>
		))
	}
</div>

<style>
	.catalogue {
		font-family: var(--font-ui);
		font-size: var(--fs-body);
		line-height: var(--lh-ui);
	}

	.catalogue__year + .catalogue__year {
		margin-block-start: var(--sp-6);
	}

	/* The year rule: an Inter label with a full-width hairline beneath it. The
	   only full-width rule on the site, and it earns it. */
	.catalogue__heading {
		padding-block-end: var(--sp-2);
		border-block-end: 1px solid var(--rule);
	}

	.catalogue__list {
		margin-block-start: var(--sp-2);
		margin-block-end: 0;
		padding: 0;
		list-style: none;
	}

	.catalogue__row {
		display: grid;
		/* The date margin, then the title. */
		grid-template-columns: 7rem 1fr;
		gap: var(--sp-3);
		align-items: baseline;
		padding-block: var(--sp-2);
	}

	.catalogue__row + .catalogue__row {
		border-block-start: 1px solid color-mix(in srgb, var(--rule) 55%, transparent);
	}

	.catalogue__date {
		font-size: var(--fs-label);
		font-weight: 500;
		letter-spacing: var(--track-label);
		color: var(--ink-muted);
		font-variant-numeric: tabular-nums;
	}

	.catalogue__title {
		/* Titles are Fraunces, not the UI sans: this is an index of writing,
		   and the type should say so before the words do. */
		font-family: var(--font-display);
		font-variation-settings: 'opsz' 30;
		font-weight: 500;
		font-size: var(--fs-title);
		line-height: 1.3;
		color: var(--ink);
		text-decoration: none;
		/* A title that wraps must not push its date away from its own first
		   line, so the date rides the baseline rather than the row top. */
		text-wrap: pretty;
		transition: color var(--t-micro) var(--ease-out);
	}

	.catalogue__title:hover {
		color: var(--ember);
	}

	/* On a phone there is no room for a 7rem margin, so the date moves above
	   the title and the row becomes a single column. */
	@media (max-width: 480px) {
		.catalogue__row {
			grid-template-columns: 1fr;
			gap: var(--sp-1);
		}
	}
</style>
