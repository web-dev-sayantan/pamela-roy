---
/**
 * SiteHeader — wordmark left, nav right, sticky.
 *
 * The bar is transparent at the top of the page and warms to paper with a
 * soft blur once the reader has scrolled 8px. On narrow screens the nav
 * collapses behind a burger button that opens a full-screen panel above the
 * room frame; the panel traps focus, closes on Escape, and returns focus
 * to the button that opened it.
 *
 * The component renders two root elements, not one: the header, and the panel
 * as its sibling. The blur is what forces that — see the note by the panel.
 */
import { SITE, isCurrentPath } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';

// One rule for "is this the page you are on", shared with the footer. See
// isCurrentPath in lib/site.
const here = Astro.url.pathname;

const isCurrent = (href: string) => isCurrentPath(here, href);
---

<header id="site-header" class="site-header">
	<div class="shell site-header__bar">
		<a class="wordmark" href="/" aria-label={`${SITE.name} — home`}>{SITE.name}</a>

		<nav class="site-header__nav" aria-label="Primary">
			<ul>
				{
					SITE.nav.map((item) => (
						<li>
							<a
								class="nav-link"
								href={item.href}
								aria-current={isCurrent(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="site-header__controls">
			<ThemeToggle />

			<!--
				The burger carries the name, not a word: the label lives in
				aria-label so the control is a named button to a screen reader and
				to a pointer, and nothing on screen has to shout MENU to do it.
				`title` is for the same reason the lamp sets one — a bare glyph
				gives a hovering mouse nothing but its shape.
			-->
			<button
				type="button"
				class="icon-button menu-button"
				aria-expanded="false"
				aria-controls="menu-panel"
				aria-label="Menu"
				title="Menu"
			>
				<!--
					Two hairlines, the site's own rule weight, rather than the
					three-bar school icon: this is the same drawing language as the
					rules between sections, so the header stays one voice. The
					name is in the button, not the glyph.
				-->
				<svg
					class="icon-button__glyph"
					viewBox="0 0 24 24"
					width="20"
					height="20"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					aria-hidden="true"
					focusable="false"
				>
					<path d="M4 9h16" />
					<path d="M4 15h16" />
				</svg>
			</button>
		</div>
	</div>
</header>

<!--
	The panel is a *sibling* of the header, not a child of it, and that placement
	is load-bearing rather than tidiness.

	`backdrop-filter` (like `transform`, `filter`, `perspective` and `contain`)
	makes an element the containing block for its `position: fixed` descendants.
	So the moment the header gains its scrolled-state blur, the panel inside it
	stopped resolving `inset: 0` against the viewport and started resolving it
	against the header's own box — 108px tall — and the menu opened as a sliver
	only once the reader had scrolled. Kept out here, the panel's containing block
	is the viewport at every scroll position, and the header can be given whatever
	filter it likes.

	It is also where a modal dialog belongs: `role="dialog"` is not part of the
	header's contents, and a full-screen overlay announced as such should not be
	buried inside the banner landmark.
-->
<div id="menu-panel" class="menu-panel" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
	<div class="menu-panel__inner shell">
		<div class="menu-panel__bar">
			<!--
				The dismissal is the burger's other half, so it is drawn the same
				way and given the same name-in-the-attribute treatment. The ×
				spans the same 16 units of the same 24-unit box as the burger's
				lines, which is what makes the two marks the same size on screen
				rather than merely the same nominal one.
			-->
			<button
				type="button"
				class="icon-button menu-panel__close"
				data-close
				aria-label="Close menu"
				title="Close menu"
			>
				<svg
					class="icon-button__glyph"
					viewBox="0 0 24 24"
					width="20"
					height="20"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					aria-hidden="true"
					focusable="false"
				>
					<path d="M4 4l16 16" />
					<path d="M20 4L4 20" />
				</svg>
			</button>
		</div>

		<nav aria-label="Mobile">
			<ul class="menu-panel__list">
				{
					SITE.nav.map((item) => (
						<li>
							<a
								class="menu-panel__link"
								href={item.href}
								aria-current={isCurrent(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</div>

<script>
	/**
	 * Re-run everything below after a navigation, once per document: the router
	 * replaces the document without re-running this script, so a handler bound
	 * at load would be bound to markup that is gone — and a swap replaces
	 * <body> outright, which is how this knows a new page has arrived.
	 *
	 * Written out in each component rather than imported: a shared module is a
	 * file of its own, and one file of its own turns every component script
	 * into a separate request. The site inlines all of its JavaScript, and
	 * scripts/check-perf.ts is the gate that says so.
	 */
	const perPage = (init: () => void) => {
		let wired: HTMLElement | null = null;

		const run = () => {
			const body = document.body;
			if (!body || body === wired) return;
			wired = body;
			init();
		};

		run();
		document.addEventListener('astro:page-load', run);
	};

	/**
	 * The header is replaced on every navigation but this script is not re-run,
	 * so the references below are refreshed by perPage and the one window
	 * listener is registered once, out here, to read whichever header is live.
	 */
	let header: HTMLElement | null = null;

	const onScroll = () => {
		header?.toggleAttribute('data-scrolled', window.scrollY > 8);
	};

	addEventListener('scroll', onScroll, { passive: true });

	// Mobile menu: a small state machine with a focus trap. No framework,
	// no dependencies — the panel is either hidden or it owns the keyboard.
	let openButton: HTMLButtonElement | null = null;
	let panel: HTMLElement | null = null;
	let closeButton: HTMLButtonElement | null = null;
	let lastFocused: HTMLElement | null = null;
	let closeTimer: number | null = null;

	const prefersReducedMotion = () =>
		matchMedia('(prefers-reduced-motion: reduce)').matches;

	/* Only elements that can actually take focus, so the trap wraps between
	   real tab stops rather than between whatever happened to match. */
	const focusables = () =>
		panel
			? [...panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')]
			: [];

	const onKeydown = (event: KeyboardEvent) => {
		if (event.key === 'Escape') {
			closeMenu();
			return;
		}

		if (event.key !== 'Tab') return;

		const items = focusables();
		if (items.length === 0) return;

		const first = items[0];
		const last = items[items.length - 1];

		if (event.shiftKey && document.activeElement === first) {
			event.preventDefault();
			last.focus();
		} else if (!event.shiftKey && document.activeElement === last) {
			event.preventDefault();
			first.focus();
		}
	};

	function openMenu() {
		if (!panel || !openButton) return;
		// Cancel a close that is still fading out: the panel is on screen,
		// just transparent, so re-opening is showing it again, not rebuilding it.
		if (closeTimer !== null) {
			clearTimeout(closeTimer);
			closeTimer = null;
		}
		// Focus is restored to whatever held it, which is the toggle itself
		// when the panel was opened by pointer. activeElement is typed as
		// Element because it can be the document, so it is narrowed here.
		lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
		panel.hidden = false;
		openButton.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
		document.addEventListener('keydown', onKeydown);
		// Forced reflow between unhiding (opacity 0) and opening (opacity 1)
		// is what the transition interpolates across. A double rAF would do
		// the same a frame later, but visibility is hidden until .is-open
		// lands — and a button inside visibility: hidden cannot take focus,
		// so focusing first would silently fail.
		void panel.offsetWidth;
		panel.classList.add('is-open');
		closeButton?.focus({ preventScroll: true });
	}

	function closeMenu() {
		if (!panel || !openButton) return;
		if (panel.hidden && !panel.classList.contains('is-open')) return;
		panel.classList.remove('is-open');
		openButton.setAttribute('aria-expanded', 'false');
		document.removeEventListener('keydown', onKeydown);

		const done = () => {
			closeTimer = null;
			if (!panel || !openButton) return;
			// A re-open during the fade wins: hidden stays off.
			if (openButton.getAttribute('aria-expanded') === 'true') return;
			panel.hidden = true;
			document.body.style.overflow = '';
			lastFocused?.focus({ preventScroll: true });
			lastFocused = null;
		};

		// Reduced motion makes the fade instant, so there is no frame to
		// wait for — hiding now avoids a fully transparent overlay that
		// still eats pointer events for 300ms.
		if (prefersReducedMotion()) {
			done();
			return;
		}
		if (closeTimer !== null) clearTimeout(closeTimer);
		// The closing fade is 200ms (see the base .menu-panel rule; opening
		// is the slower 300ms), so 240ms lands just after it without holding
		// a transparent overlay over the page.
		closeTimer = window.setTimeout(done, 240);
	}

	perPage(() => {
		if (closeTimer !== null) {
			clearTimeout(closeTimer);
			closeTimer = null;
		}
		document.body.style.overflow = '';
		header = document.getElementById('site-header');
		openButton = document.querySelector<HTMLButtonElement>('.menu-button');
		panel = document.getElementById('menu-panel');
		closeButton = panel?.querySelector<HTMLButtonElement>('[data-close]') ?? null;
		lastFocused = null;

		onScroll();

		openButton?.addEventListener('click', () => {
			const isOpen = openButton?.getAttribute('aria-expanded') === 'true';
			if (isOpen) {
				closeMenu();
			} else {
				openMenu();
			}
		});

		closeButton?.addEventListener('click', closeMenu);

		// A link tap means the reader is leaving; reset the menu state so the
		// back button never returns to a trapped, scroll-locked page.
		panel?.querySelectorAll('a[href]').forEach((link) => {
			link.addEventListener('click', closeMenu);
		});
	});
</script>

<style>
	/* The header sticks to the viewport top, but its first gutter of height is
	   empty padding: that band sits under the room frame, so the wordmark and
	   nav always start inside the casing — both in flow at the top of the page
	   and once stuck mid-scroll. */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		padding-top: var(--gutter);
		transition: background-color var(--t-base) var(--ease-out);
	}

	.site-header__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--sp-4);
		min-height: var(--header-h);
	}

	/* Transparent at rest; a breath of paper and blur once scrolled. The
	   background stays a touch translucent so the blur has something to do. */
	.site-header[data-scrolled] {
		background-color: color-mix(in srgb, var(--paper) 90%, transparent);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}

	.wordmark {
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: 500;
		line-height: 1;
		color: var(--ink);
		text-decoration: none;
	}

	.site-header__nav ul {
		display: flex;
		gap: var(--sp-4);
		list-style: none;
		padding: 0;
	}

	/* Nav links trade the default underline for an ember line that wipes in
	   from the left. The current page keeps its line, permanently lit. */
	.nav-link {
		position: relative;
		display: inline-block;
		padding-block: 0.5em;
		font-family: var(--font-ui);
		font-size: var(--fs-label);
		font-weight: 500;
		letter-spacing: var(--track-label);
		line-height: var(--lh-ui);
		text-transform: uppercase;
		color: var(--ink-soft);
		text-decoration: none;
	}

	.nav-link::after {
		content: '';
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		height: 1px;
		background: var(--ember);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--t-base) var(--ease-out);
	}

	.nav-link:hover::after {
		transform: scaleX(1);
	}

	.nav-link[aria-current='page'] {
		color: var(--ember);
	}

	.nav-link[aria-current='page']::after {
		transform: scaleX(1);
	}

	/* The lamp and the burger are one cluster at the right-hand end, so they
	   hold a single gap between them rather than the bar's `space-between`
	   deciding their distance. */
	.site-header__controls {
		display: flex;
		align-items: center;
		gap: var(--sp-4);
	}

	/* One control box, shared by the burger that opens the panel and the × that
	   dismisses it. With no word in either, the button *is* the glyph: a 20px
	   square whose right edge sits on the shell edge, so the two swap in place
	   and the pair reads as one mark drawn twice. */
	.icon-button {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--ink);
		transition: color var(--t-micro) var(--ease-out);
	}

	/* A 20px mark is a 20px target, which is no target at all. The hit area is
	   grown to 44px — the smallest square a thumb can be trusted to hit — with
	   an overlay rather than padding, because padding would push the glyph inward
	   off the shell edge and undo the alignment above. The 12px lands in the
	   empty 24px gap between the burger and the lamp, and in the panel's own
	   empty margin, so it takes nothing away from a neighbour's target. */
	.icon-button::after {
		content: '';
		position: absolute;
		inset: -12px;
	}

	.icon-button__glyph {
		flex: none;
	}

	.icon-button:hover {
		color: var(--ember);
	}

	/* The burger exists only where the inline nav does not. */
	.menu-button {
		display: none;
	}

	/* The mobile panel covers the whole viewport above the frame, with its
	   own frame clearance so no link ever touches the casing. Opacity only —
	   §9 allows nothing that triggers layout — with visibility delayed so a
	   fading panel stops taking pointer events the moment it starts closing.
	   Opening runs the slower --t-base; closing is deliberately quicker
	   (200ms) so the room answers the moment the reader dismisses it.

	   `inset: 0` here means the *viewport*, and that is only true because the
	   panel is not a descendant of the header: the scrolled header carries a
	   backdrop-filter, and any filtered ancestor would capture this box. Keep
	   the panel a sibling of <header>, not a child — see the note in the
	   markup, and the check in scripts/behaviour.ts that holds it there. */
	.menu-panel {
		position: fixed;
		inset: 0;
		z-index: 300;
		overflow-y: auto;
		background: var(--paper);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 200ms var(--ease-out),
			visibility 0s linear 200ms;
	}

	.menu-panel.is-open {
		opacity: 1;
		visibility: visible;
		transition:
			opacity var(--t-base) var(--ease-out),
			visibility 0s;
	}

	/* Same top gutter and same bar height as the header, inside the same
	   centred shell, right-aligned to the same inline edge the burger's mark
	   sits on and centred in the same 76px — so opening the panel swaps one
	   mark for the other in place. */
	.menu-panel__inner {
		display: flex;
		flex-direction: column;
		gap: var(--sp-6);
		min-height: 100%;
		padding-block: var(--gutter) var(--gutter);
	}

	.menu-panel__bar {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		min-height: var(--header-h);
	}

	/* The × is optically centred on the mark, not the box: a stroked diagonal
	   reads low, so it is lifted a hair to sit on the same optical centre as
	   the burger's horizontal lines. Transform only, so nothing reflows. */
	.menu-panel__close .icon-button__glyph {
		transform: translateY(-0.5px);
	}

	.menu-panel__list {
		display: flex;
		flex-direction: column;
		gap: var(--sp-2);
		list-style: none;
		padding: 0;
	}

	/* Links rise a breath as the panel fades in, staggered, and leave
	   together — one shared duration, opacity and transform only. */
	.menu-panel__list > li {
		opacity: 0;
		transform: translateY(10px);
		transition:
			opacity var(--t-base) var(--ease-out),
			transform var(--t-base) var(--ease-out);
	}

	.menu-panel.is-open .menu-panel__list > li {
		opacity: 1;
		transform: none;
	}

	.menu-panel.is-open .menu-panel__list > li:nth-child(1) {
		transition-delay: 60ms;
	}

	.menu-panel.is-open .menu-panel__list > li:nth-child(2) {
		transition-delay: 100ms;
	}

	.menu-panel.is-open .menu-panel__list > li:nth-child(3) {
		transition-delay: 140ms;
	}

	.menu-panel.is-open .menu-panel__list > li:nth-child(4) {
		transition-delay: 180ms;
	}

	.menu-panel.is-open .menu-panel__list > li:nth-child(5) {
		transition-delay: 220ms;
	}

	.menu-panel.is-open .menu-panel__list > li:nth-child(n + 6) {
		transition-delay: 260ms;
	}

	/* Big Fraunces links, sentence case — the menu is chrome, not a second
	   shout, so it stays out of the uppercase voice. */
	.menu-panel__link {
		font-family: var(--font-display);
		font-size: clamp(2rem, 9vw, 3rem);
		font-weight: 500;
		line-height: 1.2;
		color: var(--ink);
		text-decoration: none;
	}

	.menu-panel__link:hover {
		color: var(--ember);
	}

	.menu-panel__link[aria-current='page'] {
		color: var(--ember);
	}

	@media (max-width: 768px) {
		.site-header__nav {
			display: none;
		}

		/* The burger arrives where the inline nav leaves. Its 44px target is
		   also why it only appears once the nav it stands in for is gone: at
		   desktop widths the links are the better target and there is room for
		   both. */
		.menu-button {
			display: inline-flex;
		}
	}
</style>
