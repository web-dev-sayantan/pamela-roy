---
/**
 * /404 — nothing at this address. Short, and a way back.
 *
 * Sentence case in the source; the layout uppercases a page title, so the
 * two-case rule is decided in one place.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/Button.astro';
---

<PageLayout
	title="Nothing here"
	description="There is nothing at this address. Try one of the pages in the menu."
	noindex
>
	<section class="section section--flush">
		<div class="shell">
			<Button href="/">Back to the home page</Button>
		</div>
	</section>
</PageLayout>
