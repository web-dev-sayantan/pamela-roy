---
/**
 * /newsletter — the letter at length.
 *
 * A writer's list is her most valuable asset, so it gets a real page rather
 * than only the panel at the foot of other pages: what the letter is, what is
 * in it, and a list of what has already gone out. The copy is Markdown in
 * `pages`, the issue list is the `newsletter` collection, and the form is the
 * same SignupForm the panel uses — so none of the three can drift from the
 * others.
 */
import StaticPage from '../layouts/StaticPage.astro';
import SignupForm from '../components/SignupForm.astro';
import Empty from '../components/Empty.astro';

import { pageById } from '../lib/pages';
import { allIssues } from '../lib/newsletter';
import { monthYear } from '../lib/writings';

const page = await pageById('newsletter');
const issues = await allIssues();
---

<StaticPage page={page}>
	<Fragment slot="after">
		<hr class="rule" />

		<div class="issues">
			<div class="issues__head">
				<p class="label">Past issues</p>
				<h2 class="issues__heading">What has already gone out</h2>
			</div>

			{/* The list is empty before the first letter, which is a real state
			    and gets a real sentence rather than a heading over nothing. */}
			{
				issues.length > 0 ? (
					<ol class="issues__list" role="list">
						{issues.map((issue) => (
							<li class="issues__item">
								<p class="issues__meta">
									<time datetime={issue.data.sendDate.toISOString()}>
										{monthYear(issue.data.sendDate)}
									</time>
								</p>
								<div>
									<h3 class="issues__title">{issue.data.title}</h3>
									<p class="issues__summary">{issue.data.summary}</p>
								</div>
							</li>
						))}
					</ol>
				) : (
					<Empty label="Past issues">
						Nothing has gone out yet. The first letter will land here.
					</Empty>
				)
			}
		</div>

		<div class="subscribe">
			<p class="label">Subscribe</p>
			<h2 class="subscribe__heading">The next letter, whenever it is ready</h2>

			<SignupForm />
		</div>
	</Fragment>
</StaticPage>

<style>
	/* Both blocks below the prose sit in StaticPage's tail, which has already
	   paid for the air above the hairline. */
	.issues__head,
	.subscribe {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--sp-3);
	}

	.issues__head {
		margin-block-end: var(--sp-5);
	}

	.issues__heading,
	.subscribe__heading {
		font-family: var(--font-display);
		font-variation-settings: 'opsz' 60;
		font-weight: 500;
		font-size: var(--fs-display-m);
		line-height: var(--lh-heading);
		max-width: 22ch;
		text-wrap: balance;
	}

	/* A plain stack. Each issue becomes a two-column row at 640px, so the
	   date sits in the margin and the subject sits beside it — the same
	   gesture as the card catalogue, applied to letters. Flex rather than
	   subgrid: the row is two children wide, and a subgrid would buy nothing
	   but a browser requirement. */
	.issues__list {
		display: flex;
		flex-direction: column;
		gap: var(--sp-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.issues__item {
		display: flex;
		flex-direction: column;
		gap: var(--sp-1);
		padding-block-start: var(--sp-3);
		border-top: 1px solid var(--rule);
	}

	.issues__meta {
		font-family: var(--font-ui);
		font-size: var(--fs-label);
		font-weight: 500;
		letter-spacing: var(--track-label);
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.issues__title {
		font-family: var(--font-display);
		font-variation-settings: 'opsz' 30;
		font-weight: 600;
		font-size: var(--fs-display-s);
		line-height: 1.2;
	}

	.issues__summary {
		max-width: var(--measure);
		font-family: var(--font-prose);
		font-size: var(--fs-body);
		line-height: 1.6;
		color: var(--ink-soft);
	}

	@media (min-width: 640px) {
		.issues__item {
			flex-direction: row;
			gap: var(--sp-5);
		}

		/* The margin column: enough for "September 2025" in the small tracked
		   voice, and no more. */
		.issues__meta {
			flex: 0 0 9rem;
		}
	}
</style>
