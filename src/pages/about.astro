---
/**
 * /about — the main narrative page.
 *
 * Every word is in src/content/pages/about.md. What lives here is the part that
 * is genuinely this route's: the headshot in the right-hand margin, and a plain
 * "Get in touch" link to /contact at the foot — no button styling.
 *
 * The headshot is `src/assets/about.{jpg,jpeg,png,webp}`; until it exists the
 * margin holds an empty frame of the same shape, so the layout does not move
 * when the picture arrives. Its caption — place and date — is
 * `photoCaption` in about.md.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import StaticPage from '../layouts/StaticPage.astro';
import JsonLd from '../components/JsonLd.astro';

import { pageById } from '../lib/pages';
import { personLd, websiteLd } from '../lib/seo';

const page = await pageById('about');

const found = import.meta.glob<{ default: ImageMetadata }>('../assets/about.{jpg,jpeg,png,webp}', {
	eager: true,
});
const headshot = Object.values(found)[0]?.default;
const { portraitAlt, photoCaption } = page.data;
---

<StaticPage page={page}>
	<Fragment slot="head">
		<JsonLd data={personLd(Astro.site)} />
		<JsonLd data={websiteLd(Astro.site)} />
	</Fragment>

	<Fragment slot="aside">
		<figure class="headshot">
			<div class="headshot__frame">
				{
					headshot && (
						<Picture
							src={headshot}
							alt={portraitAlt ?? 'Pamela Roy'}
							formats={['avif', 'webp']}
							loading="eager"
							widths={[320, 480, 640]}
							sizes="(max-width: 640px) 60vw, 20rem"
						/>
					)
				}
			</div>
			{photoCaption && headshot && <figcaption class="headshot__caption">{photoCaption}</figcaption>}
		</figure>
	</Fragment>

	<Fragment slot="after">
		<p class="cv">
			<a href="/contact">Get in touch</a>
		</p>
	</Fragment>
</StaticPage>

<style>
	.headshot {
		margin: 0;
		width: min(100%, 12rem);
	}

	@media (min-width: 1080px) {
		.headshot {
			width: min(100%, 18rem);
		}
	}

	.headshot__frame {
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: 2px;
		background: var(--paper-deep);
		border: 1px solid var(--rule);
	}

	.headshot__frame :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: var(--filter-cover);
	}

	.headshot__caption {
		margin-block-start: var(--sp-2);
		font-family: var(--font-ui);
		font-size: var(--fs-label);
		font-weight: 500;
		letter-spacing: var(--track-label);
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.cv {
		font-family: var(--font-display);
		font-variation-settings: 'opsz' 40;
		font-size: var(--fs-display-s);
		line-height: 1.2;
	}
</style>
