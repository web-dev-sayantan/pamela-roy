---
/**
 * /contact — a visible email address, and no form.
 *
 * One page serves all three audiences by naming the three things Pamela is
 * open to, rather than splitting into three forms. The description is the line
 * under the title; the invitation sits on the left of the body and the
 * addresses on the right, so the page uses its width.
 */
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../lib/site';

const linkedin = SITE.socials.find((s) => s.label === 'LinkedIn');
---

<PageLayout
	title="Contact"
	description="Open to roles, consulting, collaborations and speaking."
	quiet
>
	<section class="section section--flush">
		<div class="shell contact">
			<p class="contact__invite">Open to roles, consulting, and collaboration</p>

			<dl class="contact__details">
				<div>
					<dt class="label">Email</dt>
					<dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
				</div>
				{
					linkedin && (
						<div>
							<dt class="label">LinkedIn</dt>
							<dd>
								<a href={linkedin.href}>{linkedin.href.replace(/^https?:\/\/(www\.)?/, '')}</a>
							</dd>
						</div>
					)
				}
				<div>
					<dt class="label">Based in</dt>
					<dd>Berlin, Germany</dd>
				</div>
			</dl>
		</div>
	</section>
</PageLayout>

<style>
	.contact {
		display: grid;
		gap: var(--sp-6);
	}

	.contact__invite {
		font-family: var(--font-display);
		font-variation-settings: 'opsz' 40;
		font-size: var(--fs-display-s);
		line-height: 1.25;
		color: var(--ink-soft);
		text-wrap: balance;
	}

	.contact__details {
		display: grid;
		gap: var(--sp-4);
		margin: 0;
	}

	.contact__details dd {
		margin: var(--sp-1) 0 0;
		font-family: var(--font-display);
		font-variation-settings: 'opsz' 30;
		font-size: var(--fs-display-s);
		line-height: 1.2;
		overflow-wrap: anywhere;
	}

	@media (min-width: 900px) {
		.contact {
			grid-template-columns: minmax(0, 1fr) minmax(0, var(--split-body));
			column-gap: var(--split-gap);
			align-items: start;
		}
	}
</style>
